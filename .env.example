# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id

# AI Provider: openai | gemini | openrouter | groq
AI_PROVIDER=gemini

# AI API Key (for the selected provider)
AI_API_KEY=your_ai_api_key

# AI Model (provider-specific)
AI_MODEL=gemini-2.0-flash

# Custom base URL for OpenAI-compatible providers (optional)
# AI_BASE_URL=https://api.openai.com/v1

# Confirmation timeout in seconds (default: 60)
CONFIRMATION_TIMEOUT=60
